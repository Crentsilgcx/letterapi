# React Frontend - Environment Configuration
# Copy to .env or .env.local in the "letter-delivery system frontend" folder
# DO NOT COMMIT WITH REAL VALUES

# ============================================================
# API Configuration
# ============================================================
# Base URL of the Spring Boot backend API
# In development (npm run dev), Vite proxy handles /api and /ws
# In production build, this must be the FULL public URL including protocol
#
# Examples:
#   Development (with Vite proxy): leave empty or set to http://localhost:8081
#   Production (served from same origin as backend): leave empty (uses relative paths)
#   Production (separate origin, e.g. ngrok): https://abc123.ngrok-free.app
#   Production (separate origin, LAN): http://192.168.1.100:8081
VITE_API_BASE_URL=

# WebSocket URL for real-time notifications
# In development: ws://localhost:8081/ws (proxied by Vite)
# In production: same as VITE_API_BASE_URL but with ws:// or wss://
#
# Examples:
#   Development: ws://localhost:8081/ws
#   Production (HTTPS ngrok): wss://abc123.ngrok-free.app/ws
#   Production (HTTP LAN): ws://192.168.1.100:8081/ws
VITE_WS_URL=

# ============================================================
# Admin Credentials (for Vite dev proxy only)
# ============================================================
# These are read by vite.config.js to add Basic Auth to proxied requests
# Only used during `npm run dev`. NOT included in production build.
# Must match the backend's APP_BOOTSTRAP_ADMIN_USERNAME/PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPasswordNow123