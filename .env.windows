# Letter Receipt System - Windows/XAMPP Deployment Configuration
# Copy this file to .env and update all values before deployment
# DO NOT COMMIT THIS FILE WITH REAL SECRETS

# ============================================================
# MySQL Database Configuration (XAMPP)
# ============================================================
# XAMPP MySQL default port is 3306. Default root user has no password.
# Create the database and user manually in phpMyAdmin or MySQL CLI first.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=letter_receipt
DB_USER=letter_app
DB_PASSWORD=DbPassword123

# Use SSL for MySQL? XAMPP default is no SSL.
# Set to true only if you configure MySQL with TLS certificates.
DB_USE_SSL=false
DB_REQUIRE_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Connection pool settings (adjust for your workload)
DB_POOL_MAX=10
DB_POOL_MIN=2

# ============================================================
# Spring Boot Server Configuration
# ============================================================
SERVER_PORT=8081

# ============================================================
# Application Bootstrap Admin (created on first startup)
# ============================================================
# IMPORTANT: Use a strong password (min 12 chars). This admin account
# is recreated/updated on every startup to match these values.
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=AdminPasswordNow123
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator

# ============================================================
# Application Settings
# ============================================================
APP_ORGANIZATION_NAME=Your Organization
APP_TIMEZONE=Africa/Accra

# Session cookie secure flag - set to true only when running behind HTTPS
SESSION_COOKIE_SECURE=false

# Rate limiting
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_LOGIN=8
APP_RATE_LIMIT_PUBLIC_POST=40

# ============================================================
# Thymeleaf cache (true for production, false for development)
# ============================================================
THYMELEAF_CACHE=true

# ============================================================
# Production Profile
# ============================================================
# Set SPRING_PROFILES_ACTIVE=prod when running behind HTTPS with TLS MySQL
# This enables secure session cookies and requires MySQL SSL.
# SPRING_PROFILES_ACTIVE=prod