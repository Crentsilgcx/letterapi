# Base URL of the Spring Boot backend that the mobile app calls.
#
# Must be reachable FROM THE DEVICE, not just from your machine:
#
#   Android emulator : http://10.0.2.2:8081
#                      (10.0.2.2 is an emulator-only alias for the host loopback)
#
#   Physical phone / tablet : http://<your-pc-lan-ip>:8081
#                      (find it with `ipconfig` on Windows, `ip addr` on Linux,
#                       or `ipconfig getifaddr en0` on macOS)
#
# The device and the machine running the backend must be on the same network.
#
# Copy this file to `.env.local` (already git-ignored) and set your own address.
# Expo inlines EXPO_PUBLIC_* values into the bundle, so restart with
# `npx expo start --clear` after changing it.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8081
