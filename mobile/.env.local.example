# Local development configuration - copy to .env.local and customize
# This file is gitignored (see .gitignore)

# For physical device on same LAN - replace with your actual LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.XXX:8081

# For Android emulator:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8081

# For ngrok tunnel (if using):
# EXPO_PUBLIC_API_URL=https://your-ngrok-url.ngrok-free.dev